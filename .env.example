# Copy to .env before `docker compose up`.
NEXUS_SECRET_KEY=generate-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=choose-a-db-password

# Optional: enables synthesized AI answers. Without a key, NEXUS returns
# an extractive answer built from the top sources.
NEXUS_ANTHROPIC_API_KEY=

# Alternative: use Grok (xAI) instead of Anthropic for synthesized answers.
# Get a key at console.x.ai, then set all three lines:
# NEXUS_LLM_PROVIDER=grok
# NEXUS_LLM_MODEL=grok-4.1-fast
# NEXUS_GROK_API_KEY=your-xai-key-here
